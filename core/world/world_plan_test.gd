# Godot headless verification of `whaz.gd` and `wfix.gd` against `golden-world-plan.json` (generated by
# `node core/world/test-world-hazards.js --write`), plus negative fault-injection checks.
#   godot --headless --path godot --script res://tests/world_plan/world_plan_test.gd
extends SceneTree

const WHaz := preload("whaz.gd")
const WFix := preload("wfix.gd")

var _pass := 0
var _fail := 0


func _check(label: String, cond: bool, detail: String = "") -> void:
	if cond:
		_pass += 1
		print("PASS  ", label)
	else:
		_fail += 1
		printerr("FAIL  ", label, ("  (" + detail + ")") if detail != "" else "")


func _initialize() -> void:
	var f := FileAccess.open("res://tests/world_plan/golden-world-plan.json", FileAccess.READ)
	if f == null:
		printerr("FAIL  cannot open res://tests/world_plan/golden-world-plan.json")
		quit(1)
		return
	var G = JSON.parse_string(f.get_as_text())
	if not (G is Dictionary):
		printerr("FAIL  invalid JSON in golden-world-plan.json")
		quit(1)
		return

	var plan: Dictionary = G["plan"]

	# 1. Way seasonal closures match JS golden vectors
	for wc in G["wayChecks"]:
		var res := WHaz.way_open(plan, str(wc["way"]), int(wc["yearDay"]))
		var want := bool(wc["open"])
		_check("way_open " + str(wc["way"]) + " @ day " + str(wc["yearDay"]) + " == " + str(want),
			bool(res["open"]) == want, str(res))

	# 2. Point hazard queries (`WHaz.at`) match JS golden vectors within 1e-4
	for qc in G["atChecks"]:
		var br := {}
		for k in qc["broken"]:
			br[str(k)] = true
		var got := WHaz.at(plan, float(qc["x"]), float(qc["z"]), {
			"yearDay": int(qc["yearDay"]),
			"brokenCrusts": br,
			"excludeHunter": bool(qc["excludeHunter"])
		})
		var exp_hits: Array = qc["hits"]
		var same := got.size() == exp_hits.size()
		var detail := ""
		if not same:
			detail = "count " + str(got.size()) + " vs " + str(exp_hits.size())
		else:
			for i in got.size():
				var a: Dictionary = got[i]
				var b: Dictionary = exp_hits[i]
				if str(a["id"]) != str(b["id"]) or str(a["kind"]) != str(b["kind"]) or str(a["state"]) != str(b["state"]):
					same = false
					detail = "mismatch at " + str(i) + ": " + JSON.stringify(a) + " vs " + JSON.stringify(b)
					break
				if absf(float(a["effDanger"]) - float(b["effDanger"])) > 2e-4 or absf(float(a["dose"]) - float(b["dose"])) > 2e-4 or absf(float(a["f"]) - float(b["f"])) > 2e-4:
					same = false
					detail = "float diff at " + str(i) + ": " + JSON.stringify(a) + " vs " + JSON.stringify(b)
					break
		_check("WHaz.at golden case '" + str(qc["name"]) + "' (" + str(exp_hits.size()) + " hits)", same, detail)

	# 3. Oriented-box overlap & fixture validation + negative controls
	for oc in G["overlapChecks"]:
		var ov := WFix.boxes_overlap(oc["a"], oc["b"], float(oc["gap"]))
		var want_ov := bool(oc["overlap"])
		_check("WFix.boxes_overlap matches golden (" + str(want_ov) + ")", ov == want_ov)

	var good_chk := WFix.check(plan)
	_check("WFix.check passes valid golden fixtures (" + str(good_chk["counts"]["fixtures"]) + " fixtures)", bool(good_chk["ok"]), JSON.stringify(good_chk["problems"]))

	# Negative control 1: overlapping slots must fail WFix.check
	var bad_ov: Dictionary = JSON.parse_string(JSON.stringify(plan))
	bad_ov["fixtures"][0]["slots"][1]["x"] = bad_ov["fixtures"][0]["slots"][0]["x"]
	bad_ov["fixtures"][0]["slots"][1]["z"] = bad_ov["fixtures"][0]["slots"][0]["z"]
	_check("negative: WFix.check catches overlapping fixture slots", not bool(WFix.check(bad_ov)["ok"]))

	# Negative control 2: tube fixture breaching surface must fail WFix.check
	var bad_tube: Dictionary = JSON.parse_string(JSON.stringify(plan))
	for fx in bad_tube["fixtures"]:
		if str(fx.get("on", "")) == "tube":
			fx["anchor"]["y"] = float(fx["tube"]["ground"]) + 3.0
	_check("negative: WFix.check catches tube fixture above surface", not bool(WFix.check(bad_tube)["ok"]))

	print("world_plan_test: ", _pass, " passed, ", _fail, " failed")
	quit(0 if _fail == 0 else 1)
