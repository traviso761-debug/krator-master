#!/usr/bin/env bash
# Build, check and test the World Menagerie. Run ./sitectl help for commands.
# It serves nothing itself: the one site server is Krator's, on port 8001 (the "krator" user service, run by
# ../sitectl in krator-master/host), which serves this folder's pages after `../sitectl sync`.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="$DIR/site.toml"
HOST_CTL="$DIR/../sitectl"

check() { python3 "$DIR/tools/build-page.py" >/dev/null && python3 "$DIR/server.py" --config "$CONFIG" --check; }

served() { echo "sitectl: the Menagerie has no server of its own; it is served on port 8001 by Krator's site." >&2
  if [[ -x $HOST_CTL ]]; then echo "  run: $HOST_CTL $*   (after: $HOST_CTL sync)" >&2
  else echo "  run it from krator-master: host/sitectl sync && host/sitectl $*" >&2; fi
  exit 2; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  check)    check ;;
  build)    python3 "$DIR/tools/build-page.py" ;;
  status|start|stop|restart|reload|apply|logs|follow|tail|enable|disable|url|urls|health)
            served "$cmd" ;;
  install|boot)
            served status ;;
  test)     # 1. pure modules under gjs; 2. every page in headless Firefox against its golden (tools/test-pages.py)
            rc=0; if command -v gjs >/dev/null; then gjs -m "$DIR/tests/run.js" || rc=1; else echo "gjs not installed: skipping module tests"; fi
            python3 "$DIR/server.py" --config "$CONFIG" --check >/dev/null || exit 1   # not check(): that would rebuild a stale build.js instead of failing on it
            python3 "$DIR/tools/test-pages.py" "$@" || rc=1
            exit $rc ;;
  probe)    python3 "$DIR/tools/probe.py" "$@" ;;
  help|-h|--help)
    cat <<EOF
Usage: ./sitectl <command>

  check      validate site.toml and list every URL
  build      assemble src/<city>/build.js from the stage files
  test [P..] headless check: every page builds with no errors and its layout matches tests/golden (P: only pages
             whose name starts with P; -j N pages at a time)
  probe ...  run tools/probe.py with the given arguments (metrics for one page load)

The site itself (start, stop, reload, status, logs) is Krator's, on port 8001: ../sitectl sync && ../sitectl reload.
EOF
    ;;
  *) echo "unknown command: $cmd (try ./sitectl help)" >&2; exit 2 ;;
esac
