# Auto detect text files and perform LF normalization
* text=auto

# Windows batch files need CRLF; the bash sitectl must keep LF.
*.bat text eol=crlf
host/sitectl text eol=lf
# The macOS and Linux launchers must keep LF.
*.command text eol=lf
*.sh text eol=lf
core/materials/**/*.png filter=lfs diff=lfs merge=lfs -text
core/materials/**/*.jpg filter=lfs diff=lfs merge=lfs -text
# Built pages, the kits' bundles and the packed textures (owner, 2026-10-08; README.md): generated by every build.py
# (the packs by tools/textures/pack.py), kept in LFS. LFS stores a file once by content.
settlements/*/dist/*.html filter=lfs diff=lfs merge=lfs -text
kits/*/dist/*.html filter=lfs diff=lfs merge=lfs -text
biomes/*/dist/*.html filter=lfs diff=lfs merge=lfs -text
openworld/*/dist/*.html filter=lfs diff=lfs merge=lfs -text
settlements/*/dist/*.js filter=lfs diff=lfs merge=lfs -text
kits/*/dist/*.js filter=lfs diff=lfs merge=lfs -text
biomes/*/dist/*.js filter=lfs diff=lfs merge=lfs -text
openworld/*/dist/*.js filter=lfs diff=lfs merge=lfs -text
settlements/voth/*.html filter=lfs diff=lfs merge=lfs -text
settlements/yuni/*.html filter=lfs diff=lfs merge=lfs -text
settlements/locus/*.html filter=lfs diff=lfs merge=lfs -text
settlements/girder/*.html filter=lfs diff=lfs merge=lfs -text
settlements/mavs-refuge/*.html filter=lfs diff=lfs merge=lfs -text
settlements/*/tex/*.webp filter=lfs diff=lfs merge=lfs -text
kits/*/tex/*.webp filter=lfs diff=lfs merge=lfs -text
biomes/*/tex/*.webp filter=lfs diff=lfs merge=lfs -text
openworld/*/tex/*.webp filter=lfs diff=lfs merge=lfs -text
godot/data/*/tex/*.webp filter=lfs diff=lfs merge=lfs -text
