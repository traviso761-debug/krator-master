; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Krator spike"
config/description="Krator's exports (biome tiles, atmosphere, glTF regions, records) opened in Godot to find what the importer lacks."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

Atmos="*res://krator/atmos.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/krator_gltf/plugin.cfg", "res://addons/godot_mcp/plugin.cfg")

[rendering]

anti_aliasing/quality/msaa_3d=2

[shader_globals]

season_dry={
"type": "float",
"value": 0.0
}
season_flush={
"type": "float",
"value": 0.0
}
atm_hour={
"type": "float",
"value": 12.0
}
atm_night={
"type": "float",
"value": 0.0
}
atm_time={
"type": "float",
"value": 0.0
}
atm_rain={
"type": "float",
"value": 0.0
}
atm_fog={
"type": "float",
"value": 0.0
}
atm_flash={
"type": "float",
"value": 0.0
}
atm_wind={
"type": "vec2",
"value": Vector2(0.8, 0.35)
}
atm_gust_amp={
"type": "float",
"value": 0.55
}
atm_wind_off={
"type": "vec2",
"value": Vector2(0, 0)
}
atm_light={
"type": "float",
"value": 1.0
}
atm_sun_dir={
"type": "vec3",
"value": Vector3(0.45, 0.72, -0.52)
}
atm_wave_t={
"type": "float",
"value": 0.0
}
atm_wave_amp={
"type": "float",
"value": 0.22
}
atm_deck_t={
"type": "float",
"value": 0.0
}
atm_cloud={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
atm_cloud_h={
"type": "vec4",
"value": Vector4(1600, 9000, 2600, 0.004)
}
atm_cloud_wind={
"type": "vec2",
"value": Vector2(1, 0.3)
}
atm_wet={
"type": "float",
"value": 0.0
}
atm_sky_noise={
"type": "sampler3D",
"value": ""
}
