# Generated by every build.py: the syntax-check copy of the concatenated JS.
.syntax*.js

# Python and run debris.
__pycache__/
*.pyc
log_*.txt
*.log

# Screenshots from verify.py are never committed (they were purged from history
# on 2026-09-30, 1.16 GB); keep them local or publish them elsewhere.
shots/

# Yuni's per-artifact copies (rebuilt by build.py on every run).
settlements/yuni/publish/

# Claude Code runtime state.
.claude/scheduled_tasks.lock

# Locus's build also writes these side outputs (the Yuni sheets it inherits).
settlements/locus/publish/
settlements/locus/locus-plants.html
settlements/locus/yuni-*.html
gallery/site/

# verify.py variant-shot folders (shots-var etc.)
shots-*/

# host/: the LAN server's generated files (host/sync.py, host/sitectl build)
host/site/
host/site.toml
host/menagerie/
