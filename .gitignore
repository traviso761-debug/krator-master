# Generated by every build.py: the syntax-check copy of the concatenated JS.
.syntax*.js

# Python and run debris.
__pycache__/
*.pyc
log_*.txt
*.log

# Screenshots from verify.py are never committed (they were purged from history
# on 2026-09-30, 1.16 GB); keep them local or publish them elsewhere.
shots/

# Yuni's per-artifact copies (rebuilt by build.py on every run).
settlements/yuni/publish/

# Claude Code runtime state.
.claude/scheduled_tasks.lock

# Locus's build also writes these side outputs (the Yuni sheets it inherits).
settlements/locus/publish/
settlements/locus/locus-plants.html
settlements/locus/yuni-*.html
gallery/site/

# verify.py variant-shot folders (shots-var etc.)
shots-*/

# host/: the LAN server's generated files (host/sync.py, host/sitectl build)
host/site/
host/site.toml
host/menagerie/

# kitshots.py item dumps (one per sheet)
settlements/locus/sheet-items*.json
# a local copy for headless verification only (Locus loads three.js from the CDN)
settlements/locus/three.min.js
host/address.json
host/address.json.tmp

# Agent worktrees (Claude Code): never committed.
.claude/worktrees/

# A kit's local three.js copy for verify.py (the CDN may be blocked); sedesert keeps a tracked one.
biomes/*/three.min.js

# a local three.js copy for verify.py when the CDN is blocked (not committed)
settlements/girder/three.min.js
settlements/mavs-refuge/three.min.js

# The material demo kit: a 28 MB page built from scratch sets (core/materials/demo/build.py)
core/materials/demo/dist/
core/materials/demo/mockups/*/dist/

# tools/edits: notes queued from the browser (tools/edits/README.md)
/edits/

kits/scyvoi/three.min.js

kits/fauna/scratch/
kits/fauna/three.min.js
